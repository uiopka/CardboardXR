name: Request Unity license for Mac runner

on:
  workflow_dispatch:

jobs:
  request-license:
    runs-on: macos-latest

    steps:
      - name: Install Unity CLI and Editor
        shell: bash
        run: |
          curl -fsSL https://unity.com/install.sh | bash
          export PATH="$HOME/.unity/bin:$HOME/.local/bin:$PATH"
          echo "$HOME/.unity/bin" >> "$GITHUB_PATH"
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"
          unity install 6000.6.8f1 \
            --changeset 237b6593792b \
            --accept-eula \
            --non-interactive \
            --yes

      - name: Generate activation request
        shell: bash
        run: |
          mkdir -p activation
          UNITY_BIN=$(find /Applications /Users \
            -path "*/Unity.app/Contents/MacOS/Unity" \
            -type f 2>/dev/null | head -n 1)
          test -n "$UNITY_BIN" || { echo "Unity Editor not found"; exit 1; }
          cd activation
          "$UNITY_BIN" \
            -batchmode \
            -nographics \
            -quit \
            -createManualActivationFile \
            -logFile "$GITHUB_WORKSPACE/activation/activation.log"
          ls -la

      - name: Upload activation request
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: mac-runner-activation-request
          path: activation/**
          if-no-files-found: error
